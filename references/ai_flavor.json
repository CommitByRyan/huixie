      "words": [
        "不禁", "微微", "一抹", "宛如", "宛若", "轰然",
        "淡淡道", "缓缓道", "眸光", "杀意滔天", "目光深邃",
        "嘴角微扬", "嘴角勾起", "嘴角勾起弧度", "勾起一抹",
        "心中一动", "心中一凛", "瞳孔微缩", "瞳孔骤缩",
        "眼神闪过", "眼神闪过一丝", "眼底闪过", "眸色一沉",
        "不眠之夜", "注定是个不眠之夜", "空气仿佛凝固", "空气瞬间凝固",
        "仿佛过了一个世纪", "时间仿佛静止"
      ]
    },
    {
      "id": "L2",
      "name": "解释腔 / 总结腔",
      "threshold": 6,
      "note": "叙述者跳出来总结或解释，破坏沉浸。",
      "words": [
        "值得一提的是", "总而言之", "换句话说", "由此可见",
        "不难看出", "众所周知", "不得不说", "可以说",
        "这意味着", "也就是说", "从某种意义"
      ]
    },
    {
      "id": "L3",
      "name": "神魔腔",
      "threshold": 2,
      "note": "夸张比喻与天地异象式的空转描写。",
      "words": [
        "宛如神降", "毁天灭地", "滔天", "睥睨天下",
        "合上宇宙", "经脉猛兽", "如遭雷击", "天地变色",
        "气吞山河", "不可一世"
      ]
    }
  ],
  "echo": {
    "max_len": 12,
    "max_repeat": 2,
    "note": "长度不超过 max_len 的句子（去标点后）全章最多出现 max_repeat 次。"
  },
  "layout": {
    "para_max": 200,
    "para_long_ratio": 0.3,
    "note": "移动端短段落排版：超过 para_max 字的段落占比不得高于 para_long_ratio。"
  },
  "ending": {
    "allowed_tail": ["。", "！", "？", "…", "～", "”", "』", "」", "）", ")"],
    "forbidden_tail": ["，", "、", "：", "；", "—", "（", "(", "【", "「"],
    "note": "正文末尾必须是完整句或收尾引号，禁止停在逗号、冒号、破折号。forbidden_tail 中与 allowed_tail 重合者以 allowed_tail 优先（右侧引号可收尾）。"
  }
}
